{
  "regions": ["fra1"],
  "functions": {
    "api/ssr-render/index.ts": {
      "includeFiles": "{dist-server/**,dist/public/.vite/**,dist/index.html,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*[a-z0-9])",
      "destination": "/api/ssr-render?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/:slug((?!(?:login|verify-otp|sign-up|check-email|email-confirmed|forgot-password|reset-password|workspace|select-business|onboarding|business|dashboard|invite|legal|status|admin|api|assets|public)(?:/|$))[a-z0-9][a-z0-9-]*[a-z0-9])",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/:slug((?!(?:login|verify-otp|sign-up|check-email|email-confirmed|forgot-password|reset-password|workspace|select-business|onboarding|business|dashboard|invite|legal|status|admin|api|assets|public)(?:/|$))[a-z0-9][a-z0-9-]*[a-z0-9])/:lang([a-z]{2,5})",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
